# Python
.venv/
__pycache__/
*.py[cod]

# Local logs and temp artifacts
*.log
tmp*/

# Paper LaTeX build outputs
paper/build/
paper/arxiv_sources/**/build/

# Generated cheatsheet candidates
cheatsheets/generated/
cheatsheets/generated_v2/

# Large run artifacts (raw simulator outputs)
results/sim_*.json
results/manual_distill/_tmp_*/

# Legacy and local search artifacts
results/vnext_search/
results/vnext_search_legacy/
results/vnext_search_v2/replay/
results/vnext_search_v2/decisions/
results/vnext_search_v2/context/
results/vnext_search_v2/distilled_signals/
results/vnext_search_v2/champions/history/
results/vnext_search_v2/cycles.jsonl
results/vnext_search_v2/status.md

# Notebook / editor outputs
.ipynb_checkpoints/

# Local environment files
.env

# Stage 2 generated submissions and result payloads
stage2/submissions/*.py
stage2/submissions/__pycache__/
stage2/results/*.json
stage2/results/*.jsonl
stage2/results/*.log

# Generated equation catalogs. Regenerated exactly (and verified against ETP's
# own eq_size5.txt, line for line) by:
#   python stage2/experiments/generate_eq_catalog.py --ops 6 --max-variables 2 #       --out data/generated/eq_order6_vars2.txt
data/generated/
stage2/experiments/tmp*/

# Vendored official harness local build/runtime artifacts
vendor/stage2-official/.env.judge
vendor/stage2-official/.lake/
vendor/stage2-official/lake-packages/
vendor/stage2-official/pipeline/results/
vendor/stage2-official/**/__pycache__/
vendor/stage2-official/**/*.pyc

# Lean/Lake artifacts if created outside the vendor tree
.lake/
lake-packages/

# Tool state that is currently ignored only by accident, and so would reappear
# on a fresh clone: `.pytest_cache/` is skipped only because pytest writes a
# `.gitignore` inside it, and `.claude/settings.local.json` only because this
# machine happens to carry a matching rule in its global git ignore.
.pytest_cache/
.claude/settings.local.json

# `solve_row.py` writes one directory of derivation artifacts per row it is run
# on, alongside itself. The tool is tracked; its output is not.
stage2/experiments/completion/*/
