# Local development only. Repo-owned Stage 2 helper scripts load this file
# before falling back to legacy Windows User environment variables.
# Do not assume these are available in the official solver subprocess.

# OpenRouter/OpenAI-compatible endpoint for local LLM experiments.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional local override for experiments. Official evaluation uses upstream config.
SAIR_STAGE2_MODEL=openai/gpt-oss-120b
