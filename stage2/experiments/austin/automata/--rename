import JudgeProblem
inductive submission.M : Type where
 | g : Nat→submission.M
 | J : submission.M→submission.M→submission.M
 deriving DecidableEq
namespace submission
open M
def tg : M→Nat
 | .g _ => 1
 | .J _ _ => 2
def a1 : M→M
 | .J x _ => x
 | t => t
def a2 : M→M
 | .J _ x => x
 | t => t
def sz : M→Nat
 | .g _ => 1
 | .J b0 b1 => sz b0+sz b1+1
def U (u : M) : sz (a1 u)≤sz u :=by cases u <;> simp[a1,sz] <;> omega
def sz_a2 (u : M) : sz (a2 u)≤sz u :=by cases u <;> simp[a2,sz] <;> omega
def H (t : M) (h : tg t=2) : ∃ b0 b1,t=M.J b0 b1 :=by cases t <;> simp_all[tg]
def tg_g (t : M) (h : tg t≠2) : ∃ n,t=M.g n :=by cases t <;> simp_all[tg]
def sz_tg (t : M) (h : tg t=2) : sz t=sz (a1 t)+sz (a2 t)+1 :=by obtain⟨a,b,rfl⟩:=H _ h; simp[sz,a1,a2]
@[simp] theorem tg_g_eq (n : Nat) : tg (M.g n)=1:=rfl
@[simp] theorem tg_J_eq (b0 b1 : M) : tg (M.J b0 b1)=2:=rfl
@[simp] theorem a1_J_eq (b0 b1 : M) : a1 (M.J b0 b1)=b0:=rfl
@[simp] theorem a2_J_eq (b0 b1 : M) : a2 (M.J b0 b1)=b1:=rfl
@[simp] theorem a1_g_eq (n : Nat) : a1 (M.g n)=M.g n:=rfl
@[simp] theorem a2_g_eq (n : Nat) : a2 (M.g n)=M.g n:=rfl
/-- the recursion measure: lexicographic (max size,total size),packed into one Nat -/
def W (u v : M) : Nat:=max (sz u) (sz v)*max (sz u) (sz v)+sz u+sz v
def msr_lt_of_max_lt {a b u v : M} (h : max (sz a) (sz b)<max (sz u) (sz v)) : W a b<W u v :=by
 unfold W
 have h1 : sz a+sz b≤2*max (sz a) (sz b) :=by omega
 have h2 : (max (sz a) (sz b)+1)*(max (sz a) (sz b)+1)≤max (sz u) (sz v)*max (sz u) (sz v):=Nat.mul_le_mul h h
 simp only[Nat.mul_succ,Nat.succ_mul] at h2
 omega
def msr_lt_of_max_eq {a b u v : M} (h : max (sz a) (sz b)=max (sz u) (sz v)) (h2 : sz a+sz b<sz u+sz v) : W a b<W u v :=by unfold W; rw[h]; omega
def T (u v : M) : Prop:=tg u=2∧tg (a1 u)=2∧a1 (a1 u)=a2 u∧tg v=2∧a2 (a1 u)=a1 v∧tg (a2 v)=2∧a1 (a1 u)=a1 (a2 v)
instance (u v : M) : Decidable (T u v) :=by unfold T; infer_instance
def V (u v : M) : Prop:=tg u=2∧tg (a1 u)=2∧a1 (a1 u)=a2 u∧tg v=2∧a2 (a1 u)=a1 v∧tg (a1 (a1 u))=2∧tg (a1 (a1 (a1 u)))=2∧a2 v=a2 (a1 (a1 (a1 u)))∧a1 (a1 (a1 (a1 u)))=a2 (a1 (a1 u))
instance (u v : M) : Decidable (V u v) :=by unfold V; infer_instance
def G (u v : M) : Prop:=tg u=2∧tg (a1 u)=2∧a1 (a1 u)=a2 u∧tg v=2∧a2 (a1 u)=a1 v∧tg (a1 (a1 u))=2
instance (u v : M) : Decidable (G u v) :=by unfold G; infer_instance
def X (u v : M) : Prop:=tg u=2∧tg (a1 u)=2∧a1 (a1 u)=a2 u∧tg (a2 (a1 u))=2∧tg (a1 (a2 (a1 u)))=2∧v=a2 (a1 (a2 (a1 u)))∧a1 (a1 (a2 (a1 u)))=a2 (a2 (a1 u))∧a1 (a1 u)=v
instance (u v : M) : Decidable (X u v) :=by unfold X; infer_instance
def Z (u v : M) : Prop:=tg u=2∧tg (a1 u)=2∧a1 (a1 u)=a2 u∧tg (a2 (a1 u))=2∧a1 (a1 u)=v
instance (u v : M) : Decidable (Z u v) :=by unfold Z; infer_instance
def D (u v : M) : Prop:=tg u=2∧tg (a1 u)=2∧a1 (a1 u)=a2 u∧tg (a1 (a1 u))=2∧tg (a1 (a1 (a1 u)))=2∧a1 (a1 (a1 (a1 u)))=a2 (a1 (a1 u))
instance (u v : M) : Decidable (D u v) :=by unfold D; infer_instance
def O (u v : M) : Prop:=tg u=2∧tg (a1 u)=2∧a1 (a1 u)=a2 u∧tg (a2 (a1 u))=2∧tg (a1 (a2 (a1 u)))=2∧a1 (a1 (a2 (a1 u)))=a2 (a2 (a1 u))∧v=a2 (a1 (a2 (a1 u)))∧tg (a1 (a1 u))=2∧a1 (a1 (a1 u))=v∧a2 (a1 (a1 u))=a2 (a1 u)
instance (u v : M) : Decidable (O u v) :=by unfold O; infer_instance
def E (u v : M) : Prop:=tg u=2∧tg (a1 u)=2∧a1 (a1 u)=a2 u∧tg (a2 (a2 (a1 u)))=2∧a1 (a2 (a2 (a1 u)))=a1 (a1 u)
instance (u v : M) : Decidable (E u v) :=by unfold E; infer_instance
def Q (u v : M) : Prop:=tg u=2∧tg v=2∧tg (a2 v)=2∧a2 u=a1 (a2 v)
instance (u v : M) : Decidable (Q u v) :=by unfold Q; infer_instance
def N (u v : M) : Prop:=tg u=2∧tg v=2∧tg (a2 u)=2∧tg (a1 (a2 u))=2∧a2 v=a2 (a1 (a2 u))∧a1 (a1 (a2 u))=a2 (a2 u)
instance (u v : M) : Decidable (N u v) :=by unfold N; infer_instance
def Y (u v : M) : Prop:=tg u=2∧tg v=2∧tg (a2 u)=2
instance (u v : M) : Decidable (Y u v) :=by unfold Y; infer_instance
def K (u v : M) : Prop:=tg v=2∧tg (a2 v)=2
instance (u v : M) : Decidable (K u v) :=by unfold K; infer_instance
def op (u v : M) : M :=
 let p1:=if hs1 : W (a2 (a1 (a1 u))) (a2 v)<W u v then op (a2 (a1 (a1 u))) (a2 v) else J u v
 let p2:=if hs2 : W (a2 (a2 (a1 u))) (v)<W u v then op (a2 (a2 (a1 u))) (v) else J u v
 let p3:=if hs3 : W (a2 (a1 u)) (a2 (a1 (a1 (a1 u))))<W u v then op (a2 (a1 u)) (a2 (a1 (a1 (a1 u)))) else J u v
 let p4:=if hs4 : W (a2 (a1 u)) (a2 (a2 (a1 u)))<W u v then op (a2 (a1 u)) (a2 (a2 (a1 u))) else J u v
 let p5:=if hs5 : W (a2 u) (a1 v)<W u v then op (a2 u) (a1 v) else J u v
 let p6:=if hs6 : W (a2 (a2 u)) (a2 v)<W u v then op (a2 (a2 u)) (a2 v) else J u v
 let p7:=if hs7 : W (a1 (a2 v)) (a1 v)<W u v then op (a1 (a2 v)) (a1 v) else J u v
 let p8:=if hs8 : W (p7) (a1 (a2 v))<W u v then op (p7) (a1 (a2 v)) else J u v
 if T u v then a2 (a1 u)
 else if V u v then a2 (a1 u)
 else if G u v∧W (a2 (a1 (a1 u))) (a2 v)<W u v∧a1 (a1 (a1 u))=p1 then a2 (a1 u)
 else if X u v then a2 (a1 u)
 else if Z u v∧W (a2 (a2 (a1 u))) (v)<W u v∧a1 (a2 (a1 u))=p2 then a2 (a1 u)
 else if D u v∧W (a2 (a1 u)) (a2 (a1 (a1 (a1 u))))<W u v∧v=p3 then a2 (a1 u)
 else if O u v then a2 (a1 u)
 else if E u v∧W (a2 (a1 u)) (a2 (a2 (a1 u)))<W u v∧v=p4 then a2 (a1 u)
 else if Q u v∧W (a2 u) (a1 v)<W u v∧a1 u=p5 then a1 v
 else if N u v∧W (a2 u) (a1 v)<W u v∧a1 u=p5 then a1 v
 else if Y u v∧W (a2 u) (a1 v)<W u v∧W (a2 (a2 u)) (a2 v)<W u v∧a1 u=p5∧a1 (a2 u)=p6 then a1 v
 else if K u v∧W (a1 (a2 v)) (a1 v)<W u v∧W (p7) (a1 (a2 v))<W u v∧u=p8 then a1 v
 else J u v
termination_by W u v
decreasing_by
