def inst : Magma M:={ op:=op }
def Pre (u v : M) : Prop:=T u v∨V u v∨G u v∨X u v∨Z u v∨D u v∨O u v∨E u v∨Q u v∨N u v∨Y u v∨K u v
def op_free {u v : M} (h : ¬ Pre u v) : op u v=J u v :=by rw[op.eq_1]; simp only[Pre,not_or] at h; simp[h]
def rhs : ¬ @EquationRHS M inst :=by
 intro h
 have:=h (g 1) (g 0) (g 2)
 revert this
 change ¬ g 1=op (op (g 0) (op (g 1) (g 1))) (op (op (g 0) (g 2)) (g 0))
 simp (config:={decide:=true}) [op.eq_1,sz,T,V,G,X,Z,D,O,E,Q,N,Y,K]
def I (t : M) : 1≤sz t :=by cases t <;> simp[sz] <;> omega
def sz_a1_lt {t : M} (h : tg t=2) : sz (a1 t)<sz t :=by obtain⟨a,b,rfl⟩:=H _ h; simp[sz,a1]; have:=I b; omega
def sz_a2_lt {t : M} (h : tg t=2) : sz (a2 t)<sz t :=by obtain⟨a,b,rfl⟩:=H _ h; simp[sz,a2]; have:=I a; omega
@[simp] theorem sz_J (a b : M) : sz (M.J a b)=sz a+sz b+1:=rfl
def op_cases (u v : M) : ∃ p1 p2 p3 p4 p5 p6 p7 p8 : M,
  p1=(if hs1 : W (a2 (a1 (a1 u))) (a2 v)<W u v then op (a2 (a1 (a1 u))) (a2 v) else J u v) ∧
  p2=(if hs2 : W (a2 (a2 (a1 u))) (v)<W u v then op (a2 (a2 (a1 u))) (v) else J u v) ∧
  p3=(if hs3 : W (a2 (a1 u)) (a2 (a1 (a1 (a1 u))))<W u v then op (a2 (a1 u)) (a2 (a1 (a1 (a1 u)))) else J u v) ∧
  p4=(if hs4 : W (a2 (a1 u)) (a2 (a2 (a1 u)))<W u v then op (a2 (a1 u)) (a2 (a2 (a1 u))) else J u v) ∧
  p5=(if hs5 : W (a2 u) (a1 v)<W u v then op (a2 u) (a1 v) else J u v) ∧
  p6=(if hs6 : W (a2 (a2 u)) (a2 v)<W u v then op (a2 (a2 u)) (a2 v) else J u v) ∧
  p7=(if hs7 : W (a1 (a2 v)) (a1 v)<W u v then op (a1 (a2 v)) (a1 v) else J u v) ∧
  p8=(if hs8 : W (p7) (a1 (a2 v))<W u v then op (p7) (a1 (a2 v)) else J u v) ∧
  op u v=(
 if T u v then a2 (a1 u)
 else if V u v then a2 (a1 u)
 else if G u v∧W (a2 (a1 (a1 u))) (a2 v)<W u v∧a1 (a1 (a1 u))=p1 then a2 (a1 u)
 else if X u v then a2 (a1 u)
 else if Z u v∧W (a2 (a2 (a1 u))) (v)<W u v∧a1 (a2 (a1 u))=p2 then a2 (a1 u)
 else if D u v∧W (a2 (a1 u)) (a2 (a1 (a1 (a1 u))))<W u v∧v=p3 then a2 (a1 u)
 else if O u v then a2 (a1 u)
 else if E u v∧W (a2 (a1 u)) (a2 (a2 (a1 u)))<W u v∧v=p4 then a2 (a1 u)
 else if Q u v∧W (a2 u) (a1 v)<W u v∧a1 u=p5 then a1 v
 else if N u v∧W (a2 u) (a1 v)<W u v∧a1 u=p5 then a1 v
 else if Y u v∧W (a2 u) (a1 v)<W u v∧W (a2 (a2 u)) (a2 v)<W u v∧a1 u=p5∧a1 (a2 u)=p6 then a1 v
 else if K u v∧W (a1 (a2 v)) (a1 v)<W u v∧W (p7) (a1 (a2 v))<W u v∧u=p8 then a1 v
 else J u v
  ) :=
 ⟨_,_,_,_,_,_,_,_,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,op.eq_1 u v⟩
/-- the digest: `op` is free,or an L-decode (rules 1-8,result `a2 (a1 u)`) or an R-decode
  (rules 9-12,result `a1 v`). -/
def TR (u v : M) : op u v=J u v ∨
  (tg u=2∧tg (a1 u)=2∧a1 (a1 u)=a2 u∧op u v=a2 (a1 u)) ∨
  (tg v=2∧op u v=a1 v) :=by
 obtain⟨p1,p2,p3,p4,p5,p6,p7,p8,-,-,-,-,-,-,-,-,hop⟩:=op_cases u v
 by_cases c1 : T u v
 ·exact Or.inr (Or.inl ⟨c1.1,c1.2.1,c1.2.2.1,by rw[hop,if_pos c1]⟩)
 rw[if_neg c1] at hop
 by_cases c2 : V u v
 ·exact Or.inr (Or.inl ⟨c2.1,c2.2.1,c2.2.2.1,by rw[hop,if_pos c2]⟩)
 rw[if_neg c2] at hop
 by_cases c3 : G u v∧W (a2 (a1 (a1 u))) (a2 v)<W u v∧a1 (a1 (a1 u))=p1
 ·exact Or.inr (Or.inl ⟨c3.1.1,c3.1.2.1,c3.1.2.2.1,by rw[hop,if_pos c3]⟩)
 rw[if_neg c3] at hop
 by_cases c4 : X u v
 ·exact Or.inr (Or.inl ⟨c4.1,c4.2.1,c4.2.2.1,by rw[hop,if_pos c4]⟩)
 rw[if_neg c4] at hop
 by_cases c5 : Z u v∧W (a2 (a2 (a1 u))) (v)<W u v∧a1 (a2 (a1 u))=p2
 ·exact Or.inr (Or.inl ⟨c5.1.1,c5.1.2.1,c5.1.2.2.1,by rw[hop,if_pos c5]⟩)
 rw[if_neg c5] at hop
 by_cases c6 : D u v∧W (a2 (a1 u)) (a2 (a1 (a1 (a1 u))))<W u v∧v=p3
 ·exact Or.inr (Or.inl ⟨c6.1.1,c6.1.2.1,c6.1.2.2.1,by rw[hop,if_pos c6]⟩)
 rw[if_neg c6] at hop
 by_cases c7 : O u v
 ·exact Or.inr (Or.inl ⟨c7.1,c7.2.1,c7.2.2.1,by rw[hop,if_pos c7]⟩)
 rw[if_neg c7] at hop
 by_cases c8 : E u v∧W (a2 (a1 u)) (a2 (a2 (a1 u)))<W u v∧v=p4
 ·exact Or.inr (Or.inl ⟨c8.1.1,c8.1.2.1,c8.1.2.2.1,by rw[hop,if_pos c8]⟩)
 rw[if_neg c8] at hop
 by_cases c9 : Q u v∧W (a2 u) (a1 v)<W u v∧a1 u=p5
 ·exact Or.inr (Or.inr ⟨c9.1.2.1,by rw[hop,if_pos c9]⟩)
 rw[if_neg c9] at hop
 by_cases c10 : N u v∧W (a2 u) (a1 v)<W u v∧a1 u=p5
 ·exact Or.inr (Or.inr ⟨c10.1.2.1,by rw[hop,if_pos c10]⟩)
 rw[if_neg c10] at hop
 by_cases c11 : Y u v∧W (a2 u) (a1 v)<W u v∧W (a2 (a2 u)) (a2 v)<W u v∧a1 u=p5∧a1 (a2 u)=p6
 ·exact Or.inr (Or.inr ⟨c11.1.2.1,by rw[hop,if_pos c11]⟩)
 rw[if_neg c11] at hop
 by_cases c12 : K u v∧W (a1 (a2 v)) (a1 v)<W u v∧W (p7) (a1 (a2 v))<W u v∧u=p8
 ·exact Or.inr (Or.inr ⟨c12.1.1,by rw[hop,if_pos c12]⟩)
 rw[if_neg c12] at hop
 exact Or.inl hop
/-- sizes: a decode is strictly smaller than the side it came from -/
def SZ (u v : M) : op u v=J u v∨sz (op u v)+3≤sz u∨sz (op u v)<sz v :=by
 rcases TR u v with h | ⟨h1,h2,-,h4⟩ | ⟨h1,h2⟩
 ·exact Or.inl h
 ·refine Or.inr (Or.inl ?_)
  have e1:=sz_tg u h1
  have e2:=sz_tg (a1 u) h2
  have e3:=I (a1 (a1 u))
  have e4:=I (a2 u)
  rw[h4]; omega
 ·refine Or.inr (Or.inr ?_)
  rw[h2]; exact sz_a1_lt h1
/-- THE LAW: x=((y*x)*y)*(x*(y*z)) -/
def law (x y z : M) : op (op (op (y) (x)) (y)) (op (x) (op (y) (z)))=x :=by sorry
def lhs : @EquationLHS M inst :=by
 intro x y z
 exact (law x y z).symm
end submission
def submission : Goal :=
 Exists.intro submission.M (Exists.intro submission.inst
  (And.intro submission.lhs submission.rhs))